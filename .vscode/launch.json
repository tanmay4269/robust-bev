{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train BEVFusion",
            "type": "debugpy",
            "request": "launch",
            "program": "tools/train.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "CUDA_LAUNCH_BLOCKING": "1" 
            },
            "args": [
                "projects/BEVFusion/configs/bevfusion_lidar-cam_voxel0075_second_secfpn_8xb4-cyclic-20e_nus-3d.py",
                "--cfg-options", 
                    "load_from=/workspace/projects/BEVFusion/checkpoints/bevfusion-trained.pth",
                        // https://drive.google.com/file/d/1QkvbYDk4G2d6SZoeJqish13qSyXA4lp3/view?usp=share_link
                    "model.img_backbone.init_cfg.checkpoint=/workspace/projects/BEVFusion/checkpoints/swint-nuimages-pretrained.pth",
                        // ? Do I really need to be doing this? 
                        // TODO: Check loss when this line is commented out
                    "train_dataloader.batch_size=1"
            ],
            "justMyCode": false,
        },
        {
            "name": "Resume training BEVFusion",
            "type": "debugpy",
            "request": "launch",
            "program": "tools/train.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "CUDA_LAUNCH_BLOCKING": "1" 
            },
            "args": [
                "projects/BEVFusion/configs/bevfusion_lidar-cam_voxel0075_second_secfpn_8xb4-cyclic-20e_nus-3d.py",
                "--resume", "/workspace/projects/BEVFusion/checkpoints/bevfusion_lidar-cam_voxel0075_second_secfpn_8xb4-cyclic-20e_nus-3d-5239b1af.pth",
                "--cfg-options", 
                    "train_dataloader.batch_size=1"
            ],
            "justMyCode": false,
        },
        {
            "name": "Test BEVfusion",
            "type": "debugpy",
            "request": "launch",
            "program": "tools/test.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                // "CUDA_LAUNCH_BLOCKING": "1" 
            },
            "args": [
                "projects/BEVFusion/configs/bevfusion_lidar-cam_voxel0075_second_secfpn_8xb4-cyclic-20e_nus-3d.py",
                "/workspace/projects/BEVFusion/checkpoints/bevfusion-trained.pth",
                "--cfg-options",
                    "test_dataloader.batch_size=4",
            ],
            "justMyCode": false,
        }
    ]
}